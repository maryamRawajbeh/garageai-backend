PORT=5000
PYTHON_SERVICE_URL=http://127.0.0.1:8001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
DB_PATH=./data/garageai.db

# Optional: must match INTERNAL_API_KEY in garageai-audio-analysis/.env.
# Leave empty in local dev -- the Python service skips the check when unset.
INTERNAL_API_KEY=

# Optional: password reset emails are logged to the console when these are unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
