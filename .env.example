PORT=5000
PYTHON_SERVICE_URL=http://127.0.0.1:8001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
DB_PATH=./data/garageai.db

# Optional: number of reverse-proxy hops in front of this server (e.g. 1 for a single
# nginx/Render/Railway proxy). ONLY set this if actually deployed behind a trusted
# proxy -- otherwise every per-IP rate limiter collapses into one shared bucket for
# all clients (unset) or becomes spoofable via X-Forwarded-For (set without a real
# proxy in front). Leave empty for local dev / direct exposure.
TRUST_PROXY=

# Optional: must match INTERNAL_API_KEY in garageai-audio-analysis/.env.
# Leave empty in local dev -- the Python service skips the check when unset.
INTERNAL_API_KEY=

# Optional: password reset emails are logged to the console when these are unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
